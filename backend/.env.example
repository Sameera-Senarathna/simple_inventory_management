# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# Secret key used to sign JWT auth tokens. Required in production.
# Generate a strong random value with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# If left unset, the app generates and persists a local key in
# backend/.jwt_secret (fine for development, not recommended for production).
SECRET_KEY=
